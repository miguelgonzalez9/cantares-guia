# --- Transient MCP / WhatsApp artifacts (not part of the project) ---
*.lock
mcp-logs.txt
wa-logs.txt
*-logs.txt

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini

# --- Python ---
__pycache__/
*.pyc

# --- R ---
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# --- Node / PWA build (future app/) ---
node_modules/
dist/
build/
.vite/
*.log

# --- Large generated geodata / tiles (regenerated from inputs) ---
*.pmtiles
*.mbtiles

# --- Fotos: originales crudos NO se versionan (pesados). Solo las versiones
#     web optimizadas en app/public/img/ entran al repo (las genera el script
#     data_prep/10_process_photos.py). Ver docs/MEDIA_SYSTEM.md.
inmersive_app/inputs/photos/incoming/**
inmersive_app/inputs/photos/_originals/**
!inmersive_app/inputs/photos/incoming/README.md
!inmersive_app/inputs/photos/incoming/.gitkeep

# --- Mosaicos satelitales (copia de tiles Esri; regenerables, ~13MB; Dropbox respalda) ---
inmersive_app/inputs/maps/satellite/*.jpg
inmersive_app/inputs/maps/satellite/*.jgw
inmersive_app/inputs/maps/satellite/*.prj

# --- SIC info/: contiene material PRIVADO (escrituras, contabilidad, media, WhatsApp).
#     NADA de info/ entra al repo salvo el catálogo generado y los censos json/txt.
#     Ver docs/SISTEMA_INFORMACION.md. (Antes solo se ignoraban pdf/office → fuga de
#     .rar/.mp4/.jpg privados; ahora blanket + negaciones explícitas.) ---
info/**
!info/INDEX.md
!info/catalog.json
!info/censos_inventarios/
!info/censos_inventarios/*.json
!info/censos_inventarios/*.txt

# --- SIC: fotos de campo del juego (originales; Dropbox respalda; se reingieren) ---
inmersive_app/inputs/photos/field/_incoming/*.json
inmersive_app/inputs/photos/field/_procesados/**
inmersive_app/inputs/photos/field/**/*.jpg
inmersive_app/inputs/photos/field/**/*.jpeg
inmersive_app/inputs/photos/field/**/*.png
!inmersive_app/inputs/photos/field/.gitkeep

# --- SIC: archivo de fotos de los papás (fotos Y VIDEOS crudos; Dropbox respalda;
#     clasificado local). Solo el catálogo generado + LÉEME entran al repo. ---
fotos/**
!fotos/catalog_fotos.json
!fotos/LÉEME.txt

# --- Documentos fuente que leen los scripts (PDF/Office). Son insumo, no código,
#     y este repo es PÚBLICO: entra el catálogo generado, no el original. ---
inmersive_app/inputs/documentos/**
!inmersive_app/inputs/documentos/README.md
!inmersive_app/inputs/documentos/.gitkeep

# --- Grabaciones de campo (audio de aves; Dropbox respalda) ---
audios_pajaros/**

# --- Secrets ---
.env
.env.*
!.env.example
# --- SQLite WAL/SHM transitorios de los GeoPackage (no versionar) ---
*.gpkg-wal
*.gpkg-shm

# --- Archivo crudo de la reserva (41GB; Dropbox respalda; NO al repo) ---
Reserva natural cantares/

# --- data_prep clasificador: cache de embeddings + logs (regenerables) ---
inmersive_app/data_prep/_archive_work/*.npz
inmersive_app/data_prep/_archive_work/*.log

# --- Auditoría del clasificador y caché de embeddings (data_prep/_archive_work/).
#     Contiene MINIATURAS del archivo familiar (personas, capturas de WhatsApp,
#     material de terceros) y el catálogo con rutas locales. Este repo es PÚBLICO:
#     nada de eso se versiona. El informe legible sí, en docs/EVAL_CLASIFICADOR.md.
inmersive_app/data_prep/_archive_work/**
inmersive_app/data_prep/_enrich/**

# Estado local de la CLI de Supabase (se regenera al hacer `link`; cambia por
# máquina). No lleva secretos, pero versionarlo sólo genera conflictos.
inmersive_app/supabase/.temp/

# Manifiestos y registros de deshacer que generan los scripts de data_prep
# (37_reconcile_folders, 33_filename_labels...). Son la foto de UNA corrida
# sobre el archivo local de fotos: no son codigo y no valen en otra maquina.
inmersive_app/data_prep/_reconcile_manifest.json
inmersive_app/data_prep/_reconcile_moves-*.json
inmersive_app/data_prep/_filename_moves-*.json
inmersive_app/data_prep/_bird_descriptions.json
inmersive_app/data_prep/_i18n_pending.json
inmersive_app/data_prep/_wiki_cache/
inmersive_app/data_prep/_36_run.log

# Copias de seguridad automaticas de species.json (16/23/30_*.py). Regenerables.
inmersive_app/app/public/data/species.json.bak-*
